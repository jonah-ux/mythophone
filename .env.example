# Optional server-side sound designer configuration.
# Never use a VITE_ prefix: these values must stay out of the browser bundle.
MYTHOPHONE_AI_API_KEY=
MYTHOPHONE_AI_MODEL=
# Optional OpenAI-compatible base URL. The default is https://api.openai.com/v1.
MYTHOPHONE_AI_BASE_URL=https://api.openai.com/v1
MYTHOPHONE_API_PORT=8787
# Optional static-host base path. Leave unset for local root hosting; the Pages workflow sets this automatically.
MYTHOPHONE_BASE_PATH=/
