# Optional server-side sound designer configuration.
# Never use a VITE_ prefix: these values must stay out of the browser bundle.
MYTHOPHONE_AI_API_KEY=
MYTHOPHONE_AI_MODEL=
# Optional OpenAI-compatible base URL. The default is https://api.openai.com/v1.
MYTHOPHONE_AI_BASE_URL=https://api.openai.com/v1
MYTHOPHONE_API_PORT=8787
# Browser origin allowed to call the adapter. Keep the local default for development; set this to the deployed frontend origin when separated.
MYTHOPHONE_WEB_ORIGIN=http://127.0.0.1:5175
# Optional static-host base path. Leave unset for local root hosting; the Pages workflow sets this automatically.
MYTHOPHONE_BASE_PATH=/
# Optional public browser-facing adapter URL for a separately hosted frontend. Leave blank to use the local /api/design proxy.
# This value is a route, not a credential; keep provider keys in the server environment above.
VITE_MYTHOPHONE_API_URL=
